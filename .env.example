# Optional local overrides — copy to .env (do not commit .env)
# IQ.Pilot / openpilot device development helpers

# SSH target for your comma-class device
IQLINK_COMMA_HOST=comma@YOUR_DEVICE_IP

# Device openpilot path (usually unchanged)
IQLINK_DEVICE_ROOT=/data/openpilot

# Optional: model download host used by iqmodeld bundle URIs
# MODEL_HOST=https://YOUR_MODEL_HOST

# Optional: if you vendor imgui/libusb for the tools extra, point UV/pip at your mirror
# UV_EXTRA_INDEX_URL=
# IQLINK_TOOLS_DEPS_GIT=https://YOUR_GIT_HOST/your-org/dependencies.git

# Optional API host override (defaults to public konn3kt API)
# API_HOST=https://api-iqlabs.konn3kt.com
# KONN3KT_API_HOST=https://api-iqlabs.konn3kt.com

# Optional MLX / jotpluggler stream target
# REMOTE_HOST=YOUR_DEVICE_IP
# MLX_IP=10.0.0.1
